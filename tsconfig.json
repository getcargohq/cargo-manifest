{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "infra/**/*.ts", ".cargo-ai/**/*.d.ts"],
  "exclude": ["node_modules", "infra/apps/*/**", "infra/workers/*/**"]
}
