{
  "extraKnownMarketplaces": {
    "cargo-skills": {
      "source": { "source": "github", "repo": "getcargohq/cargo-skills" }
    }
  },
  "enabledPlugins": { "cargo@cargo-skills": true },
  "permissions": {
    "allow": [
      "Bash(cargo-ai cdk plan*)",
      "Bash(cargo-ai cdk types*)",
      "Bash(npm run lint:context*)",
      "Bash(npm run typecheck*)"
    ],
    "deny": [
      "Bash(cargo-ai cdk deploy*)",
      "Bash(cargo-ai cdk destroy*)",
      "Bash(cargo-ai project deploy*)",
      "Bash(cargo-ai project destroy*)",
      "Bash(cargo-cdk deploy*)",
      "Bash(cargo-cdk destroy*)",
      "Bash(npx @cargo-ai/cli cdk deploy*)",
      "Bash(npx @cargo-ai/cli cdk destroy*)",
      "Bash(npx @cargo-ai/cli project deploy*)",
      "Bash(npx @cargo-ai/cli project destroy*)",
      "Bash(npx @cargo-ai/cdk deploy*)",
      "Bash(npx @cargo-ai/cdk destroy*)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)"
    ]
  }
}
