{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.ts", ".cargo-ai/**/*.d.ts"],
  "exclude": ["node_modules", "apps/*/**", "workers/*/**"]
}
