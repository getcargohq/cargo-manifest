# Copy to .env and fill in. Never commit .env.
# Secrets are read at deploy time via secret()/env() in infra/ and by scripts/.

# Cargo workspace API key (Workspace settings > API tokens)
CARGO_API_KEY=

# LLM provider key for local evals (promptfoo). The eval runs the same model as
# the deployed sdr agent (claude-sonnet-5), so it needs the Anthropic key.
ANTHROPIC_API_KEY=

# Only needed if you swap an agent back to the openai connector (see
# infra/connectors/openai.ts) and want its eval to run locally.
OPENAI_API_KEY=

# infra/ deploys need no other secrets: models are native and connectors are
# adopted (configured in the workspace UI). Add a secret here only when you wire
# a connector with secret("NAME") (e.g. a CRM), matching the name you reference.
