{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/deny-local-deploy.py",
        "matcher": "(?:\\bcargo-ai|@cargo-ai/cli)(?:@\\S*)?(?:\\s+-\\S+)*\\s+(?:project|cdk)\\s+(?:deploy|destroy)\\b|(?:\\bcargo-cdk|@cargo-ai/cdk)(?:@\\S*)?(?:\\s+-\\S+)*\\s+(?:deploy|destroy)\\b|\\b(?:npm|pnpm|yarn|bun)(?:\\s+-\\S+)*\\s+(?:run(?:-script)?(?:\\s+-\\S+)*\\s+)?[\\\"']?deploy(?![\\w:-])",
        "failClosed": true
      }
    ]
  }
}
